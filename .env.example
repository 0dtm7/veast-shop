# VEAST environment variables

# Telegram token from @BotFather.
# Do not commit a real token to GitHub.
TELEGRAM_BOT_TOKEN=

# Bot username without @.
TELEGRAM_BOT_USERNAME=VEAST_Order_Bot

# Public Render URL, for example:
# https://veast.onrender.com
PUBLIC_BASE_URL=https://veast-shop-nsdh.onrender.com

# Admin key for updating order statuses in admin-orders.html.
# Do not commit a real key to GitHub. Set it in Render Environment Variables.
ADMIN_STATUS_KEY=

# CDEK pickup point widget.
# Get these in the CDEK integration account.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Test: https://api.edu.cdek.ru/v2. Production: https://api.cdek.ru/v2.
CDEK_API_BASE_URL=https://api.edu.cdek.ru/v2
CDEK_FROM_CITY=Москва
CDEK_DEFAULT_LOCATION=Москва

# Yandex Maps JavaScript API key for the CDEK widget map.
# Restrict it by HTTP Referrer to your Render domain.
YANDEX_MAPS_API_KEY=

# SQLite mini database path.
# Default: data/veast.sqlite.
# For real persistence on Render with a Persistent Disk, use: /var/data/veast.sqlite
VEAST_DB_PATH=data/veast.sqlite
