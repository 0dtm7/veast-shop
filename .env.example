# VEAST environment variables

# PostgreSQL database. Required on Render if orders must persist after deploy/restart.
# Create a Render PostgreSQL database and copy its Internal Database URL here.
DATABASE_URL=
# Optional. Use only if your external PostgreSQL connection requires SSL.
# DATABASE_SSL=require

# Telegram token from @BotFather.
# Do not commit a real token to GitHub.
TELEGRAM_BOT_TOKEN=

# Bot username without @.
TELEGRAM_BOT_USERNAME=VEAST_Order_Bot

# Public Render URL.
PUBLIC_BASE_URL=https://veast-shop-nsdh.onrender.com

# Admin key for updating order statuses in admin-orders.html.
# Do not commit a real key to GitHub. Set it in Render Environment Variables.
ADMIN_STATUS_KEY=

# CDEK pickup points map.
# Test credentials from CDEK docs can be used with https://api.edu.cdek.ru/v2.
# Production credentials from your signed CDEK contract use https://api.cdek.ru/v2.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_BASE_URL=https://api.edu.cdek.ru/v2
CDEK_FROM_CITY=Москва
CDEK_DEFAULT_LOCATION=Москва

# The CDEK pickup map uses OpenStreetMap + Leaflet, so Yandex Maps key is not required.
